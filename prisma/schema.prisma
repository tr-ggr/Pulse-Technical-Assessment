// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id       String   @id // client-generated session uuid
  lat      Float // ALREADY privacy-offset coords (raw is never stored)
  lng      Float
  busy     Boolean  @default(false) // true while in an active connection
  peerId   String? // session id of the active partner (set with busy)
  // Outgoing connection request, so the server can tell a real accept from a
  // forged one. One at a time; expires with REQUEST_TIMEOUT_MS.
  requestTo String?
  requestAt DateTime?
  lastSeen DateTime

  @@index([lastSeen])
  @@index([requestTo])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}

model RateLimit {
  // Fixed-window request counters (and the reaper lease), keyed by e.g.
  // "poll:<sessionId>" or "ip:<sha256(ip)>". Rows are useless after their
  // window and get swept by the reaper, so nothing here outlives a session.
  key         String   @id
  windowStart DateTime
  count       Int

  @@index([windowStart])
}
