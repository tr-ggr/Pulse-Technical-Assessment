DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional: direct (non-pooled) URL used by the Prisma CLI for db push/migrate.
# On Neon this is the host without "-pooler". Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"
# Optional, dev only: comma-separated extra hosts allowed to reach the dev
# server (e.g. an ngrok tunnel for testing on a phone).
DEV_ORIGINS=""
